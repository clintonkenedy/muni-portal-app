# Copy to .env.dev (quasar dev) and .env.prod (quasar build). Never commit them.

# Core API (muni-usuarios back-end), WITHOUT a trailing slash and WITHOUT /api.
API_CORE_URL=http://localhost:8000

# OIDC (Ory Hydra public URL). Must match the `iss` of the tokens.
OIDC_AUTHORITY=http://localhost:4444
# Web client of the PORTAL sistema ("Accesos (clients)" in the core).
OIDC_CLIENT_ID=
OIDC_REDIRECT_URI=http://localhost:9100/oidc-callback
OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:9100/
OIDC_SCOPE="openid profile email offline_access"
